{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/projectgg.frontend/browser",
  "functions": {
    "api/*.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://projectgg-api-ch95.onrender.com/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
